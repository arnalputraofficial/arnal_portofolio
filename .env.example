# Copy this file to .env and fill in the values from your Supabase project.
#
# Both values are safe to publish: they end up inside the browser bundle either
# way. Access control lives in row level security policies in the database, not
# in the secrecy of these strings.
#
# The publishable key replaced the old anon key. The admin panel accepts either
# name, but a project created from scratch now hands out the publishable one.
#
# Never put the database password or the service_role key in this file.
#
# The three values below are only used by the serverless route in api/contact.ts.
# They must not carry the VITE_ prefix, because that prefix means "ship this to
# the browser": RESEND_API_KEY is a real secret and belongs on the server only.
# Set them in the Vercel project settings, not in a committed file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

RESEND_API_KEY=re_your_resend_key
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=you@your-domain.com
